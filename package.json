{
  "name": "runlist",
  "displayName": "Runlist",
  "description": "Control local projects across repositories from one focused sidebar.",
  "version": "0.0.8",
  "publisher": "hankoswart",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/runlist.png",
  "galleryBanner": {
    "color": "#161B22",
    "theme": "dark"
  },
  "pricing": "Free",
  "markdown": "github",
  "repository": {
    "type": "git",
    "url": "https://github.com/HSwart/Runlist.git"
  },
  "homepage": "https://github.com/HSwart/Runlist#readme",
  "bugs": {
    "url": "https://github.com/HSwart/Runlist/issues"
  },
  "keywords": [
    "local development",
    "project manager",
    "task runner",
    "developer tools",
    "projects",
    "ports",
    "coding agents",
    "start",
    "stop",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.113.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:runlist.projects",
    "onCommand:runlist.addProject",
    "onCommand:runlist.showAgentSetup",
    "onCommand:runlist.transferProjects",
    "onCommand:runlist.manageGroups"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "runlist.addProject",
        "title": "Add Project",
        "icon": "$(add)"
      },
      {
        "command": "runlist.showAgentSetup",
        "title": "Set Up Agent Connections",
        "icon": "$(plug)"
      },
      {
        "command": "runlist.transferProjects",
        "title": "Import or Export Projects",
        "icon": "$(files)"
      },
      {
        "command": "runlist.manageGroups",
        "title": "Manage Run Groups",
        "icon": "$(run-all)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "runlist.projects",
        "label": "Runlist"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runlist",
          "title": "Runlist",
          "icon": "media/runlist.svg"
        }
      ]
    },
    "views": {
      "runlist": [
        {
          "type": "webview",
          "id": "runlist.projects",
          "name": "Runlist"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "runlist.addProject",
          "when": "view == runlist.projects",
          "group": "navigation@1"
        },
        {
          "command": "runlist.showAgentSetup",
          "when": "view == runlist.projects",
          "group": "navigation@2"
        },
        {
          "command": "runlist.transferProjects",
          "when": "view == runlist.projects",
          "group": "navigation@3"
        },
        {
          "command": "runlist.manageGroups",
          "when": "view == runlist.projects",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "runlist.showAgentSetup",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "test:smoke": "node smoke/run.js",
    "validate:marketplace": "node scripts/validate-marketplace.js --preparation",
    "validate:marketplace:publish": "node scripts/validate-marketplace.js",
    "validate:marketplace:vsix": "node scripts/validate-vsix.js",
    "package": "npm run validate:marketplace:publish && vsce package --no-dependencies --out releases/runlist.vsix",
    "publish:marketplace": "npm run validate:marketplace:publish && npm run validate:marketplace:vsix && vsce publish --azure-credential --packagePath releases/runlist.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2"
  }
}
