{
  "name": "runlist",
  "displayName": "Runlist",
  "description": "Start, stop, and switch local apps from one sidebar.",
  "version": "0.0.13",
  "publisher": "hankoswart",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/runlist.png",
  "galleryBanner": {
    "color": "#161B22",
    "theme": "dark"
  },
  "screenshots": [
    {
      "path": "media/gallery-01-hero.png"
    },
    {
      "path": "media/gallery-02-status.png"
    },
    {
      "path": "media/gallery-03-features.png"
    }
  ],
  "pricing": "Free",
  "markdown": "github",
  "repository": {
    "type": "git",
    "url": "https://github.com/HSwart/Runlist.git"
  },
  "homepage": "https://github.com/HSwart/Runlist#readme",
  "bugs": {
    "url": "https://github.com/HSwart/Runlist/issues"
  },
  "keywords": [
    "npm scripts",
    "task runner",
    "dev server",
    "process manager",
    "ports",
    "local development",
    "development control panel",
    "local dev server",
    "dev server manager",
    "local apps",
    "command runner",
    "script runner",
    "project commands",
    "port manager",
    "localhost",
    "multi-project",
    "monorepo",
    "microservices",
    "run groups",
    "developer tools",
    "coding agents",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.113.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:runlist.projects",
    "onCommand:runlist.addProject",
    "onCommand:runlist.showAgentSetup",
    "onCommand:runlist.transferProjects",
    "onCommand:runlist.manageGroups",
    "onCommand:runlist.showPortListening",
    "onCommand:runlist.importCompose",
    "onCommand:runlist.copySupportDiagnostics",
    "onCommand:runlist.startThisFolder"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "runlist.addProject",
        "title": "Add Project",
        "category": "Runlist",
        "icon": "$(add)"
      },
      {
        "command": "runlist.showAgentSetup",
        "title": "Set Up Agents",
        "category": "Runlist",
        "icon": "$(plug)"
      },
      {
        "command": "runlist.transferProjects",
        "title": "Import or Export",
        "category": "Runlist",
        "icon": "$(files)"
      },
      {
        "command": "runlist.manageGroups",
        "title": "Manage Groups",
        "category": "Runlist",
        "icon": "$(run-all)"
      },
      {
        "command": "runlist.showPortListening",
        "title": "What's Listening",
        "category": "Runlist",
        "icon": "$(server-process)"
      },
      {
        "command": "runlist.importCompose",
        "title": "Import Compose Services",
        "category": "Runlist"
      },
      {
        "command": "runlist.copySupportDiagnostics",
        "title": "Copy Runlist Support Diagnostics",
        "category": "Runlist"
      },
      {
        "command": "runlist.startThisFolder",
        "title": "Start This Folder",
        "category": "Runlist"
      }
    ],
    "configuration": {
      "title": "Runlist",
      "properties": {
        "runlist.diagnostics.trace": {
          "type": "boolean",
          "default": false,
          "description": "Include bounded, redacted error details in the local Runlist output and copied support diagnostics."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "runlist.projects",
        "label": "Runlist"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "runlist",
          "title": "Runlist",
          "icon": "media/runlist.svg"
        }
      ]
    },
    "views": {
      "runlist": [
        {
          "type": "webview",
          "id": "runlist.projects",
          "name": "Runlist"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "runlist.addProject",
          "when": "view == runlist.projects",
          "group": "navigation@1"
        },
        {
          "command": "runlist.showAgentSetup",
          "when": "view == runlist.projects && runlist.showTitlebarExtras",
          "group": "navigation@2"
        },
        {
          "command": "runlist.transferProjects",
          "when": "view == runlist.projects && runlist.showTitlebarExtras",
          "group": "navigation@3"
        },
        {
          "command": "runlist.manageGroups",
          "when": "view == runlist.projects && runlist.showTitlebarExtras",
          "group": "navigation@4"
        },
        {
          "command": "runlist.showPortListening",
          "when": "view == runlist.projects && runlist.showTitlebarExtras",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "runlist.showAgentSetup",
          "when": "false"
        },
        {
          "command": "runlist.showPortListening",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "scan:secrets": "node scripts/scan-secrets.js",
    "test": "node --test",
    "test:compose-lifecycle": "node --test test/compose-lifecycle.integration.js",
    "test:critical-coverage": "node scripts/test-critical-coverage.js",
    "test:smoke": "node smoke/run.js",
    "test:webview": "node scripts/webview-e2e.js",
    "update:webview-screenshot": "node scripts/webview-e2e.js --update-screenshot",
    "validate:marketplace": "node scripts/validate-marketplace.js --preparation",
    "validate:marketplace:publish": "node scripts/validate-marketplace.js",
    "validate:marketplace:vsix": "node scripts/validate-vsix.js",
    "validate:sbom": "node scripts/validate-sbom.js",
    "quality": "npm run lint && npm run scan:secrets && npm run test:critical-coverage && npm run validate:sbom && npm run validate:marketplace:vsix",
    "verify": "npm run quality && npm test && npm run test:smoke",
    "package": "npm run validate:marketplace:publish && node scripts/package-vsix.js",
    "publish:marketplace": "npm run validate:marketplace:publish && npm run validate:marketplace:vsix && vsce publish --azure-credential --packagePath releases/runlist.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "playwright-core": "1.62.1"
  }
}
