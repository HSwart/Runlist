{
  "name": "switchboard",
  "displayName": "Switchboard",
  "description": "Start and stop local projects from one focused sidebar.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.113.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:switchboard.projects",
    "onCommand:switchboard.addProject",
    "onCommand:switchboard.showAgentSetup"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "switchboard.addProject",
        "title": "Add Project",
        "icon": "$(add)"
      },
      {
        "command": "switchboard.showAgentSetup",
        "title": "Set Up Agent Connections",
        "icon": "$(plug)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "switchboard.projects",
        "label": "Switchboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "switchboard",
          "title": "Switchboard",
          "icon": "media/switchboard.svg"
        }
      ]
    },
    "views": {
      "switchboard": [
        {
          "type": "webview",
          "id": "switchboard.projects",
          "name": "Switchboard"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "switchboard.addProject",
          "when": "view == switchboard.projects",
          "group": "navigation@1"
        },
        {
          "command": "switchboard.showAgentSetup",
          "when": "view == switchboard.projects",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "switchboard.showAgentSetup",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
