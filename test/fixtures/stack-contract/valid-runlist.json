{
  "schemaVersion": 1,
  "projects": [
    {
      "name": "Web",
      "folder": ".",
      "startCommand": "npm run dev",
      "stopCommand": "",
      "services": [
        { "name": "web", "port": 3000 }
      ],
      "tags": ["app"],
      "launchProfiles": []
    },
    {
      "name": "API",
      "folder": "apps/api",
      "startCommand": "npm start",
      "services": [
        { "name": "api", "port": 4000, "url": "http://localhost:4000/health" }
      ]
    }
  ],
  "groups": [
    {
      "name": "Full stack",
      "projectFolders": [".", "apps/api"],
      "startMode": "parallel"
    }
  ]
}
